# Copia este archivo a .env.local y completa los valores.
# Sin estas variables la app corre en modo demo (datos de ejemplo + progreso en localStorage).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NUNCA pongas la service role key en una variable NEXT_PUBLIC_*.
# No hace falta en esta app: las migraciones se aplican en el SQL Editor
# o con la CLI de Supabase, y el cliente solo usa la anon key.
# SUPABASE_SERVICE_ROLE_KEY=
